+    console.warn(`[physics] non-finite position (${pos.x}, ${pos.y}, ${pos.z}), velocity (${vel.x}, ${vel.y}, ${vel.z}); ` +
+      `restoring ${lastGoodPosition ? lastGoodPosition.toString() : 'nothing (no finite position seen yet)'} [#${bot.nanRecoveries}]`)
+    // Only the broken axes come back. y is finite and still under gravity, so a bot that was falling keeps
+    // falling; pinning it to an old mid-air position would look like flying and get it kicked for that instead.
+    if (lastGoodPosition) {
+      if (!Number.isFinite(pos.x)) pos.x = lastGoodPosition.x
+      if (!Number.isFinite(pos.y)) pos.y = lastGoodPosition.y
+      if (!Number.isFinite(pos.z)) pos.z = lastGoodPosition.z
+    }
+    if (!Number.isFinite(vel.x)) vel.x = 0
+    if (!Number.isFinite(vel.y)) vel.y = 0
+    if (!Number.isFinite(vel.z)) vel.z = 0
