+  // mindcraft fork: never let a non-finite position reach the server. On 1.21.x the bot's x/z occasionally
+  // become NaN (seen after taking damage and after server position corrections); the next movement packet then
+  // gets the bot kicked with "Invalid move player packet received". Put it back where it last was instead.
+  let lastGoodPosition = null
+  bot.nanRecoveries = 0
+  function repairNonFinitePosition () {
+    // A NaN heading turns into NaN movement on the next step, so it is repaired along with the position.
+    if (!Number.isFinite(bot.entity.yaw) || !Number.isFinite(bot.entity.pitch)) {
+      bot.nanRecoveries++
+      console.warn(`[physics] non-finite heading (yaw ${bot.entity.yaw}, pitch ${bot.entity.pitch}); resetting it [#${bot.nanRecoveries}]`)
+      if (!Number.isFinite(bot.entity.yaw)) bot.entity.yaw = 0
+      if (!Number.isFinite(bot.entity.pitch)) bot.entity.pitch = 0
+    }
+    // A NaN velocity (a packet read wrongly) becomes a NaN position on the next step, so it goes too.
+    const v = bot.entity.velocity
+    if (!Number.isFinite(v.x) || !Number.isFinite(v.y) || !Number.isFinite(v.z)) {
+      bot.nanRecoveries++
+      console.warn(`[physics] non-finite velocity (${v.x}, ${v.y}, ${v.z}); zeroing the broken axes [#${bot.nanRecoveries}]`)
+      if (!Number.isFinite(v.x)) v.x = 0
+      if (!Number.isFinite(v.y)) v.y = 0
+      if (!Number.isFinite(v.z)) v.z = 0
+    }
+    const pos = bot.entity.position
+    if (Number.isFinite(pos.x) && Number.isFinite(pos.y) && Number.isFinite(pos.z)) {
+      if (lastGoodPosition) lastGoodPosition.update(pos)
