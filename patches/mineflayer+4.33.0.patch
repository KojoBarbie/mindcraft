+// mindcraft fork: minecraft-data 3.116 (pulled in through ^3.97.0) describes spawn_entity and entity_velocity with
+// `velocity: {x, y, z}` (vec3i16) where mineflayer 4.33 still reads velocityX/Y/Z. Reading the old names gave
+// undefined, i.e. a NaN velocity on every knockback, which the next physics step turned into a NaN position:
+// kicks for "Invalid move player packet" and a pathfinder raycast that never ended. Both shapes are read; a
+// packet with neither is reported once rather than silently taken as standing still.
+let unreadableVelocityReported = false
+function readNotchVelocity (packet) {
+  const v = packet.velocity && typeof packet.velocity === 'object' ? packet.velocity : { x: packet.velocityX, y: packet.velocityY, z: packet.velocityZ }
+  if (!Number.isFinite(v.x) || !Number.isFinite(v.y) || !Number.isFinite(v.z)) {
+    if (!unreadableVelocityReported) {
+      unreadableVelocityReported = true
+      console.warn('[entities] a velocity packet in an unknown shape; treating it as zero:', JSON.stringify(Object.keys(packet)))
+    }
+  }
+  return new Vec3(Number.isFinite(v.x) ? v.x : 0, Number.isFinite(v.y) ? v.y : 0, Number.isFinite(v.z) ? v.z : 0)
